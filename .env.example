# Anthropic — powers the 12 agents and the client assistant.
ANTHROPIC_API_KEY=

# Clerk — optional. When unset the app runs in demo mode (no auth, demo analyst/client).
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=
CLERK_SECRET_KEY=
NEXT_PUBLIC_CLERK_SIGN_IN_URL=/sign-in

# Mapbox — optional. When unset the properties map renders a vector fallback.
NEXT_PUBLIC_MAPBOX_TOKEN=

# ── Database ─────────────────────────────────────────────────────────────
# Neon Postgres connection string (Neon dashboard → Connection details → "Pooled").
# Leave empty to run on the embedded demo database (PGlite, resets on restart).
DATABASE_URL=

# Protects POST /api/setup (creates tables and seeds demo data). Any long random string.
SETUP_SECRET=

# ── Auth (Clerk) ─────────────────────────────────────────────────────────
# Leave both empty to run in open demo mode (no sign-in, admin persona).
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=
CLERK_SECRET_KEY=
# Clerk → Webhooks → endpoint https://<your-domain>/api/webhooks/clerk → Signing secret
CLERK_WEBHOOK_SECRET=
NEXT_PUBLIC_CLERK_SIGN_IN_URL=/sign-in
NEXT_PUBLIC_CLERK_SIGN_UP_URL=/sign-up

# ── AI (Anthropic) ───────────────────────────────────────────────────────
ANTHROPIC_API_KEY=
# Optional overrides. Defaults: claude-sonnet-4-20250514 (deep work), claude-haiku-4-5 (fast work).
ANTHROPIC_MODEL_PRIMARY=
ANTHROPIC_MODEL_FAST=

# ── Storage & jobs ───────────────────────────────────────────────────────
# Vercel → Storage → Blob → connect to project (sets this automatically).
BLOB_READ_WRITE_TOKEN=
# Vercel sets CRON_SECRET for cron requests; set any random string here too.
CRON_SECRET=

# ── Maps ─────────────────────────────────────────────────────────────────
# Optional. Without it the properties map renders a vector fallback.
NEXT_PUBLIC_MAPBOX_TOKEN=

# ── App ──────────────────────────────────────────────────────────────────
NEXT_PUBLIC_APP_URL=http://localhost:3000

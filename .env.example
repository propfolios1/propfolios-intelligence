# ── Database ─────────────────────────────────────────────────────────────
# Supabase Postgres. Either connect Supabase in Vercel → Storage (sets POSTGRES_URL
# and POSTGRES_URL_NON_POOLING automatically), or paste the Transaction pooler
# address (Supabase → Connect → Transaction pooler, port 6543) as DATABASE_URL.
# Leave all empty to run on the embedded demo database (PGlite, resets on restart).
DATABASE_URL=
# Optional direct address (port 5432) used only when creating tables.
DATABASE_URL_DIRECT=

# Protects POST /api/setup (creates tables and seeds demo data). Any long random string.
SETUP_SECRET=

# ── Auth (Clerk) ─────────────────────────────────────────────────────────
# Leave both empty to run in open demo mode (no sign-in, persona switching).
# Clerk must have Organizations enabled; each organisation is one tenant.
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=
CLERK_SECRET_KEY=
# Clerk → Webhooks → endpoint https://<your-domain>/api/webhooks/clerk → Signing secret
CLERK_WEBHOOK_SECRET=
NEXT_PUBLIC_CLERK_SIGN_IN_URL=/sign-in
NEXT_PUBLIC_CLERK_SIGN_UP_URL=/sign-up

# ── AI (Anthropic) ───────────────────────────────────────────────────────
ANTHROPIC_API_KEY=
# Optional overrides. Defaults: claude-sonnet-4-20250514 (deep work), claude-haiku-4-5 (fast work).
ANTHROPIC_MODEL_PRIMARY=
ANTHROPIC_MODEL_FAST=

# ── Storage & jobs ───────────────────────────────────────────────────────
# Vercel → Storage → Blob → connect to project (sets this automatically).
BLOB_READ_WRITE_TOKEN=
# Vercel sets CRON_SECRET for cron requests; set any random string here too.
CRON_SECRET=

# ── Maps ─────────────────────────────────────────────────────────────────
# Optional. Without it the properties map renders a vector fallback.
NEXT_PUBLIC_MAPBOX_TOKEN=

# ── App ──────────────────────────────────────────────────────────────────
NEXT_PUBLIC_APP_URL=http://localhost:3000

# ── Rate limiting (optional) ─────────────────────────────────────────────
# Vercel → Storage → Upstash Redis sets the KV_* pair. Either pair works.
# Without them each server instance limits requests in memory.
KV_REST_API_URL=
KV_REST_API_TOKEN=
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# Nakhla environment variables. Set these in Vercel → Project → Settings →
# Environment Variables. Everything except SETUP_SECRET is optional for a
# demonstration deployment; each section says what happens without it.

# ── Supabase ─────────────────────────────────────────────────────────────
# Supabase → Project Settings → API (or the Connect button).
NEXT_PUBLIC_SUPABASE_URL=https://xxxx.supabase.co
# Public anon key: browser Realtime subscriptions, filtered by row-level security.
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Service role key: server only (Storage uploads and signed URLs). Never expose it.
SUPABASE_SERVICE_ROLE_KEY=

# Database connection. Supabase → Connect → Transaction pooler (port 6543), with
# your database password in place of [YOUR-PASSWORD]. The session pooler (5432)
# also works. Without it the app runs on an embedded demo database that resets.
DATABASE_URL=postgresql://postgres.xxxx:password@aws-0-ap-south-1.pooler.supabase.com:6543/postgres
# Optional direct address, used only when creating tables.
DATABASE_URL_DIRECT=
# (The Vercel Supabase integration sets POSTGRES_URL and POSTGRES_URL_NON_POOLING
# instead; Nakhla reads those when DATABASE_URL is empty.)

# ── Setup ────────────────────────────────────────────────────────────────
# Protects /api/setup (creates tables, row-level security, buckets and seed data).
SETUP_SECRET=

# ── Clerk (sign-in and firm workspaces) ──────────────────────────────────
# Without both keys the app runs in open demonstration mode with persona switching.
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=pk_
CLERK_SECRET_KEY=sk_
# Clerk → Webhooks → https://<your-domain>/api/webhooks/clerk → Signing secret.
CLERK_WEBHOOK_SECRET=
NEXT_PUBLIC_CLERK_SIGN_IN_URL=/sign-in
NEXT_PUBLIC_CLERK_SIGN_UP_URL=/sign-up

# ── Anthropic ────────────────────────────────────────────────────────────
# Without it agents run in deterministic replay mode.
ANTHROPIC_API_KEY=sk-ant-
# Optional model overrides (defaults shown). Cross-validation uses all three.
ANTHROPIC_MODEL_DEEP=claude-opus-4-20250514
ANTHROPIC_MODEL_PRIMARY=claude-sonnet-4-20250514
ANTHROPIC_MODEL_FAST=claude-haiku-4-5

# ── App ──────────────────────────────────────────────────────────────────
NEXT_PUBLIC_APP_URL=https://yourdomain.com
# Scheduled jobs run on Supabase Cron. The edge functions relay to
# /api/jobs/<job> with this bearer token; set the same value as a Supabase
# function secret together with NAKHLA_APP_URL (your site's address).
NAKHLA_JOBS_SECRET=
# 32 random bytes (hex or base64) that encrypt third-party credentials (CRM,
# portal and WhatsApp tokens). Falls back to a key derived from SETUP_SECRET.
NAKHLA_ENCRYPTION_KEY=
# Set to true only for the one-time rename of demonstration tenants seeded by
# earlier releases (POST /api/migrate/rename-demo-tenants), then remove.
DEMO_RENAME_ENABLED=
# Optional: salt for federation hashes. Defaults to SETUP_SECRET. Set once, never change.
FEDERATION_SALT=

# ── Email (Resend) ───────────────────────────────────────────────────────
# Invoices, signature requests, KYC reminders and notification emails.
# Without it every email is kept in the outbox (status "not configured") and
# the in-app notification still arrives. Resend → API Keys; verify your domain
# under Resend → Domains, then use an address on it as the sender.
RESEND_API_KEY=
RESEND_FROM=PropFolios <advisory@yourdomain.com>

# ── Electronic signature (Dropbox Sign) ──────────────────────────────────
# Without it contracts are signed with Nakhla's native signature: a one-time
# link per signer, typed name, consent, IP address, time and a SHA-256 hash of
# the contract. Dropbox Sign → API → API key. Webhook URL to register there:
# https://<your-domain>/api/webhooks/dropbox-sign (events are verified with the key).
DROPBOX_SIGN_API_KEY=
# "true" sends test-mode requests (free, watermarked). Set "false" in production.
DROPBOX_SIGN_TEST_MODE=true

# ── Optional ─────────────────────────────────────────────────────────────
# Shared rate limiting (Vercel → Storage → Upstash Redis sets the KV pair).
KV_REST_API_URL=
KV_REST_API_TOKEN=
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
# Fallback file storage when Supabase Storage is not configured.
BLOB_READ_WRITE_TOKEN=
# Street-level property map.
NEXT_PUBLIC_MAPBOX_TOKEN=

# AML screening (OpenSanctions match API). Without it a fictional sample list is used.
OPENSANCTIONS_API_KEY=

# --- Production modules ---
# Card billing for Starter and Professional (Stripe Checkout over the REST API). Without it, upgrades are invoiced.
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
# Where this deployment's Supabase project stores data, for example eu-central-1 or ap-south-1. Shown on Data residency and Security.
NAKHLA_DATA_REGION=
# Signs audit exports (HMAC-SHA256). Falls back to SETUP_SECRET; set its own value in production.
AUDIT_EXPORT_SECRET=
# Signs portal feed and calendar addresses. Falls back to SETUP_SECRET.
FEED_SECRET=
# Domain on which firm websites are served as subdomains (default nakhla.site).
NAKHLA_SITES_DOMAIN=
# Web push for the agent app (generate a VAPID key pair once; the public key is needed twice).
NAKHLA_VAPID_PUBLIC_KEY=
NAKHLA_VAPID_PRIVATE_KEY=
NAKHLA_VAPID_SUBJECT=mailto:support@nakhla.ai
NEXT_PUBLIC_VAPID_PUBLIC_KEY=
# CRM migration: Follow Up Boss registered system key, and the Salesforce login host for sandboxes (test.salesforce.com).
FUB_SYSTEM_KEY=
SALESFORCE_LOGIN_URL=
# OpenSanctions self-hosted instance (defaults to the hosted API) and 360dialog base URL override.
OPENSANCTIONS_URL=
D360_BASE_URL=
# Lead response: milliseconds the AI may take before the deterministic reply is sent (default 6000).
LEAD_RESPONSE_MODEL_BUDGET_MS=
# Where access requests from the public site are emailed.
ACCESS_REQUEST_EMAIL=
